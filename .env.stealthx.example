# STEALTHX — dev .env для docker-compose.stealthx.yml (локальная разработка)
#   cp .env.stealthx.example .env.stealthx
#   ./scripts/docker-stealthx-up.sh
#
# Production: см. .env.stealthx.production.example + docker-compose.stealthx.prod.yml

TZ=Europe/Moscow

# Обязательно (openssl rand -hex 32):
SHOPBOT_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

POSTGRES_USER=shopbot
POSTGRES_DB=shopbot

# STEALTHX JWT (если пусто — используется SHOPBOT_SECRET_KEY)
# STEALTHX_JWT_SECRET=
STEALTHX_JWT_ACCESS_MINUTES=15
STEALTHX_JWT_REFRESH_DAYS=7

# При старте контейнера: включить webapp, дизайн stealthx, seed тарифов/серверов
STEALTHX_AUTO_CONFIGURE=1
STEALTHX_INIT_STRICT=0

# Локальная отладка по HTTP (без HTTPS)
SHOPBOT_SESSION_SECURE=0
SHOPBOT_REQUIRE_TOTP=0
SHOPBOT_DEBUG=0
