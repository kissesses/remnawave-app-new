# STEALTHX — production standalone (.env)
#
#   cp .env.stealthx.production.example .env
#   ./scripts/docker-stealthx-prod-up.sh
#
# Домен landing: https://stealthx.example.com/  (nginx → 127.0.0.1:8000)

TZ=Europe/Moscow
SHOPBOT_IMAGE_TAG=latest

# ── Секреты (openssl rand -hex 32) ─────────────────────────────────────────
SHOPBOT_SECRET_KEY=
SHOPBOT_MASTER_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Отдельный JWT-секрет (рекомендуется в prod)
STEALTHX_JWT_SECRET=

POSTGRES_USER=shopbot
POSTGRES_DB=shopbot

# ── Безопасность ─────────────────────────────────────────────────────────────
SHOPBOT_SESSION_SECURE=1
SHOPBOT_REQUIRE_TOTP=1
SHOPBOT_TRUST_PROXY=1
SHOPBOT_DEBUG=0

# ── Домен WebApp / STEALTHX ──────────────────────────────────────────────────
# Укажите домен без https:// — для Passkey и cookie
# WEBAPP_DOMAIN=stealthx.example.com
SHOPBOT_RP_ID=stealthx.example.com
SHOPBOT_RP_ORIGIN=https://stealthx.example.com

# ── STEALTHX ─────────────────────────────────────────────────────────────────
SHOPBOT_WEBAPP_TOKEN_DAYS=90
STEALTHX_JWT_ACCESS_MINUTES=15
STEALTHX_JWT_REFRESH_DAYS=7
STEALTHX_AUTO_CONFIGURE=1
STEALTHX_INIT_STRICT=1
