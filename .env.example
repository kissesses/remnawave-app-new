# Скопируйте в .env и настройте:
#   cp .env.example .env
#
# Запуск:
#   docker compose pull && docker compose up -d
#   docker compose up -d --build   # локальная сборка
#
# Инструкция: docs/INSTALL.md
# STEALTHX landing: http://127.0.0.1:8000/  ·  кабинет: /app  ·  панель: :1337

# ── Общие ────────────────────────────────────────────────────────────────────
TZ=Europe/Moscow
SHOPBOT_IMAGE_TAG=latest

# ── Docker-сеть ──────────────────────────────────────────────────────────────
# Co-install с Remnawave Panel (по умолчанию):
COMPOSE_NETWORK_EXTERNAL=true
COMPOSE_NETWORK_NAME=remnawave-network
#
# Standalone без Panel:
# COMPOSE_NETWORK_EXTERNAL=false
# COMPOSE_NETWORK_NAME=shopbot-network

# Лимиты памяти (опционально)
# APP_MEM_LIMIT=1024m
# POSTGRES_MEM_LIMIT=768m
# REDIS_MEM_LIMIT=192m

# Сборка образа: INSTALL_DOCKER_CLI=0 — без docker-cli в контейнере

# ── Безопасность ─────────────────────────────────────────────────────────────
# openssl rand -hex 32
SHOPBOT_SECRET_KEY=
SHOPBOT_MASTER_KEY=

POSTGRES_USER=shopbot
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=shopbot

REDIS_PASSWORD=

SHOPBOT_SESSION_SECURE=1
SHOPBOT_REQUIRE_TOTP=1
SHOPBOT_TRUST_PROXY=0
SHOPBOT_DEBUG=0

# ── Домены (WebAuthn + WebApp) ───────────────────────────────────────────────
# SHOPBOT_RP_ID=app.example.com
# SHOPBOT_RP_ORIGIN=https://app.example.com

# ── WebApp ───────────────────────────────────────────────────────────────────
SHOPBOT_WEBAPP_TOKEN_DAYS=90

# ── STEALTHX (landing + JWT API) ─────────────────────────────────────────────
# JWT-секрет (пусто = SHOPBOT_SECRET_KEY)
# STEALTHX_JWT_SECRET=
STEALTHX_JWT_ACCESS_MINUTES=15
STEALTHX_JWT_REFRESH_DAYS=7
STEALTHX_AUTO_CONFIGURE=1
STEALTHX_INIT_STRICT=0

# ── Remnawave co-install ───────────────────────────────────────────────────────
REMNAWAVE_BACKUP_COMPOSE_DIR=/opt/remnawave
SHOPBOT_COMPOSE_PROJECT_DIR=/opt/remnawave-app

# ── Developer Support (опционально) ──────────────────────────────────────────
DEVELOPER_SUPPORT_ENABLED=0
# DEVELOPER_SUPPORT_HUB_URL=
