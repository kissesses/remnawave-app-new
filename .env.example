# Скопируйте в .env и настройте под свой сервер:
#   cp .env.example .env
#
# Рекомендуется: Remnawave Panel на том же сервере (co-install).
# Инструкция: docs/INSTALL.md
#
# Docker Compose подхватит значения при запуске:
#   docker compose up -d
#
# Prod (без исходников, как Remnawave Panel):
#   curl -o docker-compose.yml .../docker-compose.yml, образ ghcr.io/kissesses/remnawave-app
# SHOPBOT_IMAGE_TAG=latest
# Обновление из панели (О проекте → Обновить): в docker-compose.yml раскомментируйте
# /var/run/docker.sock и каталог проекта; путь должен совпадать с хостом:
# SHOPBOT_COMPOSE_PROJECT_DIR=/opt/remnawave-app
#
# Большинство настроек (бот, платежи, хосты) задаются через веб-панель
# после первого входа на /setup. Здесь — только параметры окружения сервера.

# ── Общие ────────────────────────────────────────────────────────────────────
# Часовой пояс контейнера (логи, cron). В коде панели время — MSK (UTC+3).
TZ=Europe/Moscow

# ── Безопасность панели ───────────────────────────────────────────────────────
# Генерация: docs/INSTALL.md (openssl + sed)
# ОБЯЗАТЕЛЬНО: стабильный ключ (openssl rand -hex 32). Без него приложение не стартует.
SHOPBOT_SECRET_KEY=

# Доверять X-Forwarded-For / CF-Connecting-IP (1 = за nginx/cloudflare, 0 = только remote_addr)
SHOPBOT_TRUST_PROXY=0

# Cookie только по HTTPS (1 = да, 0 = для локальной отладки по HTTP)
SHOPBOT_SESSION_SECURE=1

SHOPBOT_MASTER_KEY=

# Каталог данных (master key и пр.). PostgreSQL хранится в volume postgres-data.
# SHOPBOT_DATA_DIR=/app/project/data
#
# Архивы бэкапов — только в Docker volume (не на хосте):
#   backups-data → /app/project/backups (см. docker-compose.yml)
# SHOPBOT_BACKUPS_DIR=/app/project/backups

# Принудительная 2FA для всех администраторов (prod: 1)
# 1 = обязательны TOTP, Passkey или Telegram (не «только пароль»)
SHOPBOT_REQUIRE_TOTP=1

# ── Passkey (WebAuthn) ─────────────────────────────────────────────────────────
# Нужны, если включён вход через Passkey в Настройки → Доступ.
# Без них RP ID берётся из заголовка Host (может не работать за прокси).

# Домен без порта и протокола
# SHOPBOT_RP_ID=shop.example.com

# Полный origin панели (схема + домен; для HTTPS на 443 порт не указывайте)
# SHOPBOT_RP_ORIGIN=https://shop.example.com

# ── Redis (rate limiting) ─────────────────────────────────────────────────────
# Используется для лимитов входа и защиты от перебора.
# При недоступности Redis — fallback на in-memory (не подходит для нескольких воркеров).
# Генерация — docs/INSTALL.md (openssl + sed):
#   rp=$(openssl rand -hex 24)
#   grep -qE '^REDIS_PASSWORD=' .env && sed -i -E "s/^#? ?REDIS_PASSWORD=.*/REDIS_PASSWORD=${rp}/" .env || echo "REDIS_PASSWORD=${rp}" >> .env
#   sed -i -E "s|^#? ?SHOPBOT_REDIS_URL=.*|SHOPBOT_REDIS_URL=redis://:${rp}@redis:6379/0|" .env
#   grep -qE '^SHOPBOT_REDIS_URL=' .env || echo "SHOPBOT_REDIS_URL=redis://:${rp}@redis:6379/0" >> .env
REDIS_PASSWORD=
# URL: docker-compose подставит redis://:${REDIS_PASSWORD}@redis:6379/0, если SHOPBOT_REDIS_URL не задан
# SHOPBOT_REDIS_URL=redis://:password@redis:6379/0

# ── PostgreSQL (обязательная БД) ──────────────────────────────────────────────
# Генерация POSTGRES_PASSWORD — docs/INSTALL.md:
#   pw=$(openssl rand -hex 24) && sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$pw/" .env
POSTGRES_USER=shopbot
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=shopbot
# PostgreSQL доступен только внутри Docker-сети (без ports на хост).
# Подключение: docker compose exec postgres psql -U shopbot -d shopbot
# URL ShopBot собирается автоматически в docker-compose.yml из переменных выше.

# ── WebApp ────────────────────────────────────────────────────────────────────
# Срок жизни токена Telegram WebApp (дней)
SHOPBOT_WEBAPP_TOKEN_DAYS=90

# ── Отладка ───────────────────────────────────────────────────────────────────
# 1 = включить отладочные эндпоинты вебхуков (только для разработки!)
SHOPBOT_DEBUG=0

# ── Remnawave co-install (встроено в docker-compose.yml) ───────────────────────
# Каталог Remnawave на хосте — для бэкапов Panel (монтируется read-only в контейнер)
REMNAWAVE_BACKUP_COMPOSE_DIR=/opt/remnawave

# ── Developer Support (клиент → remote hub) ───────────────────────────────────
# Клиентская установка отправляет тикеты на maintainer hub:
# DEVELOPER_SUPPORT_ENABLED=1
# DEVELOPER_SUPPORT_HUB_URL=https://support.example.com
#
# Общая сессия Flask на поддоменах (panel + support.example.com):
# SHOPBOT_SESSION_COOKIE_DOMAIN=.example.com
#
# Требования перед docker compose up:
#   docker network inspect remnawave-network
#   test -f /opt/remnawave/.env
# Volumes: postgres-data, redis-data, backups-data (архивы не в ./backups/ на хосте)
