# Production — co-install с Remnawave Panel
#
# Установка:
#   mkdir -p /opt/remnawave-app && cd /opt/remnawave-app
#   curl -o docker-compose.yml https://raw.githubusercontent.com/kissesses/remnawave-app-new/main/docker-compose.yml
#   curl -o docker-compose.production.yml https://raw.githubusercontent.com/kissesses/remnawave-app-new/main/docker-compose.production.yml
#   cp .env.production.example .env
#   # заполните секреты (см. docs/INSTALL.md)
#   docker network create remnawave-network  # если ещё нет
#   docker compose -f docker-compose.yml -f docker-compose.production.yml pull
#   docker compose -f docker-compose.yml -f docker-compose.production.yml up -d
#
# STEALTHX landing: https://app.example.com/
# Кабинет:         https://app.example.com/app
# Панель ShopBot:   https://shop.example.com/

TZ=Europe/Moscow
SHOPBOT_IMAGE_TAG=latest

# ── Обязательные секреты (openssl rand -hex 32) ─────────────────────────────
SHOPBOT_SECRET_KEY=
SHOPBOT_MASTER_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

POSTGRES_USER=shopbot
POSTGRES_DB=shopbot

# ── Безопасность (production defaults) ──────────────────────────────────────
SHOPBOT_SESSION_SECURE=1
SHOPBOT_REQUIRE_TOTP=1
SHOPBOT_TRUST_PROXY=1
SHOPBOT_DEBUG=0

# ── Домены (для WebAuthn и webapp_domen в панели) ───────────────────────────
# Домен WebApp / STEALTHX landing (без https://)
# WEBAPP_DOMAIN=app.example.com
# SHOPBOT_RP_ID=app.example.com
# SHOPBOT_RP_ORIGIN=https://app.example.com

# ── WebApp / STEALTHX ───────────────────────────────────────────────────────
SHOPBOT_WEBAPP_TOKEN_DAYS=90

# JWT (пусто = SHOPBOT_SECRET_KEY; для prod лучше отдельный секрет)
# STEALTHX_JWT_SECRET=
STEALTHX_JWT_ACCESS_MINUTES=15
STEALTHX_JWT_REFRESH_DAYS=7
STEALTHX_AUTO_CONFIGURE=1
STEALTHX_INIT_STRICT=1

# ── Co-install Remnawave ─────────────────────────────────────────────────────
REMNAWAVE_BACKUP_COMPOSE_DIR=/opt/remnawave
SHOPBOT_COMPOSE_PROJECT_DIR=/opt/remnawave-app

# Redis URL собирается в docker-compose.yml из REDIS_PASSWORD
# SHOPBOT_REDIS_URL=redis://:password@redis:6379/0

# ── Developer Support (опционально) ─────────────────────────────────────────
DEVELOPER_SUPPORT_ENABLED=0
# DEVELOPER_SUPPORT_HUB_URL=
